# Set these to the models available to you. Never commit your real API key.
OLLAMA_MODEL=your-local-code-model
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_MODEL=your-cloud-model
ANTHROPIC_API_KEY=your-key-here

# Cloud prices in USD per million tokens; confirm against your selected model.
PRICE_DATE=YYYY-MM-DD
CLOUD_INPUT_USD_PER_MILLION=
CLOUD_OUTPUT_USD_PER_MILLION=

MAX_LOCAL_CHARS=6000
PROVIDER_TIMEOUT_MS=120000
